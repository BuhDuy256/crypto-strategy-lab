# PostgreSQL connection settings.
#
# Used by:
#   - docker-compose.yml (starts and configures the PostgreSQL container)
#   - apps/backend/src/platform/config.ts (the backend config loader)
#
# Copy this file to .env and adjust values for local development:
#   cp .env.example .env
#
# Do not put real secrets in this file (.env.example). Real values go in
# .env, which is not committed to version control.

# Hostname the backend uses to reach PostgreSQL.
# Use "localhost" for the host development path (backend runs on your machine).
# The full-system Compose path does NOT use this value: its backend services
# run inside the Compose network and reach PostgreSQL by service name, so
# docker-compose.yml sets POSTGRES_HOST=postgres for them. You do not edit this
# file to switch paths.
POSTGRES_HOST=localhost

# Port PostgreSQL is published on for the host development path. The Compose
# path reaches PostgreSQL on the internal port 5432 (set in docker-compose.yml),
# independent of this published value.
POSTGRES_PORT=5432

# Database user created on first container start.
POSTGRES_USER=crypto_strategy_lab

# Database user password created on first container start.
# Placeholder only. Replace with a locally generated value; never reuse
# this placeholder for anything beyond a local machine.
POSTGRES_PASSWORD=change-me-local-dev-password

# Database name created on first container start.
POSTGRES_DB=crypto_strategy_lab

# Host ports the full-system Compose path publishes for the API and the SPA.
# Compose only (the host development path starts these with pnpm instead).
# Change them if 3000 or 8080 is already taken on your machine.
API_PORT=3000
WEB_PORT=8080

# V4 Redis Pub/Sub is ephemeral. The host path uses localhost; Compose overrides
# REDIS_URL so the API reaches the redis service on its internal port.
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# Per-subscription outbound message bound. A client that exceeds it is
# disconnected and must reconnect, which always requests a fresh snapshot.
WS_OUTBOUND_BUFFER_MAX=32
# Resource bound on one WebSocket client, not a chart count.
WS_SUBSCRIPTION_MAX=32

# Number of backtest jobs processed concurrently by the separate runner process.
BACKTEST_RUNNER_CONCURRENCY=1

# Fixed size (K) of every Top-K leaderboard projection. Defaults to 10 when unset.
LEADERBOARD_TOP_K=10

# Reproducible build identity. Required by BOTH the backtest runner and the API
# process (the API freezes each search spec with these, so both must carry the
# same values or a result fails acceptance). On the Compose path they are passed
# to the api and runner services from this file. Replace for each build/run;
# DEPENDENCY_LOCK_HASH must be a 64-character SHA-256 hex string.
DEPENDENCY_LOCK_HASH=replace-with-pnpm-lock-sha256
APPLICATION_COMMIT=replace-with-application-commit
WORKER_COMMIT=replace-with-worker-commit
DETERMINISTIC_CONFIG_VERSION=1.0.0

# Which live streams the market ingest process holds open (MKT-06).
# One symbol, and the timeframes it subscribes to on a single Binance
# connection. Every timeframe must be one the domain supports:
# 1m, 5m, 15m, 30m, 1h, 2h, 4h, 1d.
MARKET_INGEST_SYMBOL=BTCUSDT
MARKET_INGEST_TIMEFRAMES=1m,5m,15m,30m,1h,2h,4h,1d

# WebSocket origin the market ingest process connects to. The default is the
# public Binance market-data stream endpoint. Point it at a local server only
# when replaying a recorded stream.
BINANCE_STREAM_URL=wss://data-stream.binance.vision

# CoinDesk RSS is the owner-approved first News source (NEWS-02). Collection reads
# only this feed's title, summary, canonical link, and publication time; it never
# requests article pages. Keep the poll interval conservative.
NEWS_COINDESK_RSS_URL=https://www.coindesk.com/arc/outboundfeeds/rss/
NEWS_POLL_INTERVAL_MS=900000
NEWS_REQUEST_TIMEOUT_MS=10000
NEWS_RETRY_COUNT=2
NEWS_RETRY_DELAY_MS=1000

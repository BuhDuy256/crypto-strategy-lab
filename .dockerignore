# Keep the build context small and the image reproducible.
#
# node_modules is excluded on purpose: the host tree is built for the host OS,
# while the image installs its own Linux dependencies from the frozen lockfile.
# Never copy a local .env into an image; container config comes from Compose.
**/node_modules
node_modules

.env
.env.*
!.env.example

.git
.gitignore

.scratch
**/dist
**/.vite
**/coverage
**/*.log

# Editor and OS noise.
.vscode
.idea
.DS_Store
Thumbs.db

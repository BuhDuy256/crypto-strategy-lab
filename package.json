{
  "name": "crypto-strategy-lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "start:api": "pnpm --filter @crypto-strategy-lab/backend run start:api",
    "start:ui": "pnpm --filter @crypto-strategy-lab/web run dev",
    "start:backtest-runner": "pnpm --filter @crypto-strategy-lab/backend run start:backtest-runner",
    "start:news-worker": "pnpm --filter @crypto-strategy-lab/backend run start:news-worker",
    "news:collect": "pnpm --filter @crypto-strategy-lab/backend run news:collect",
    "news:analyze": "pnpm --filter @crypto-strategy-lab/backend run news:analyze",
    "start:market-ingest": "pnpm --filter @crypto-strategy-lab/backend run start:market-ingest",
    "market:backfill": "pnpm --filter @crypto-strategy-lab/backend run market:backfill --",
    "demo:seed": "node scripts/seed-demo-data.mjs",
    "smoke:ws03": "tsx scripts/smoke-ws03.ts",
    "smoke:mkt07": "tsx scripts/smoke-mkt07.ts",
    "smoke:mkt09": "tsx scripts/smoke-mkt09.ts",
    "smoke:mkt11": "tsx scripts/smoke-mkt11.ts",
    "leaderboard:rebuild": "pnpm --filter @crypto-strategy-lab/backend run leaderboard:rebuild --",
    "migrate": "pnpm --filter @crypto-strategy-lab/backend run migrate",
    "migrate:reset": "pnpm --filter @crypto-strategy-lab/backend run migrate:reset"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/common": "^11.2.1",
    "@nestjs/testing": "^11.2.1",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.18.1",
    "eslint": "^9.18.0",
    "playwright-core": "^1.55.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8",
    "ws": "^8.21.3"
  }
}
